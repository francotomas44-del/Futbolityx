# Servidor
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Detras de un proxy (Railway, Render, Fly, Nginx): true solo si el proxy
# agrega X-Forwarded-For de forma confiable.
TRUST_PROXY=false

# Origenes permitidos para el navegador (separados por coma).
CORS_ORIGINS=https://francotomas44-del.github.io,http://localhost:8766,http://127.0.0.1:8766

# API keys en JSON.
# - "key": texto plano, solo para desarrollo local.
# - "keyHash": SHA-256 en hexadecimal, recomendado en produccion.
# - "scopes": analyze, live, meta, *.
# - "ips": allowlist de IPs/CIDR para esa key (opcional).
#
# Para desarrollo:
API_KEYS=[{"id":"dev","key":"dev_change_me","scopes":["*"],"ips":[]}]
#
# Para produccion (genera el hash con: npm run hash-key):
# API_KEYS=[{"id":"web","keyHash":"<sha256>","scopes":["analyze","live"],"ips":[]}]

# Allowlist global de IPs/CIDR. Vacio = sin allowlist.
# OJO: los navegadores usan la IP del usuario, que cambia. Esto sirve para
# llamadas server-to-server, no para restringir a los usuarios finales.
IP_ALLOWLIST=

# Limites
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute
BODY_LIMIT_BYTES=8388608
ANALYZE_MAX_MATCHES=50000
ANALYZE_MAX_TEAMS=20000

# Datos en vivo (upstream)
UPSTREAM_TIMEOUT_MS=8000
UPSTREAM_CACHE_MS=30000

# Precios propuestos (todavia no se cobra)
PLAN_PRO_ARS_MONTHLY=6900
PLAN_PRO_ARS_YEARLY=59000
PLAN_PRO_USD_MONTHLY=9
PLAN_PRO_USD_YEARLY=90
PLAN_ELITE_ARS_MONTHLY=14900
PLAN_ELITE_ARS_YEARLY=129000
PLAN_ELITE_USD_MONTHLY=19
PLAN_ELITE_USD_YEARLY=190

# IDs de precio de Paddle (creados en el dashboard de Paddle Billing).
PLAN_PADDLE_PRO_MONTHLY=
PLAN_PADDLE_PRO_YEARLY=
PLAN_PADDLE_ELITE_MONTHLY=
PLAN_PADDLE_ELITE_YEARLY=

# IDs de plan de suscripcion de Mercado Pago (preapproval_plan_id).
PLAN_MP_PRO_MONTHLY=
PLAN_MP_PRO_YEARLY=
PLAN_MP_ELITE_MONTHLY=
PLAN_MP_ELITE_YEARLY=

# Pagos: completar recien cuando se active el cobro.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# URL publica del frontend (para links de verificacion y retorno de pago).
APP_URL=http://localhost:8766
