# Servidor
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# URLs publicas. APP_URL es el frontend; API_PUBLIC_URL es este backend.
# En Vercel: APP_URL=https://tu-frontend.vercel.app
#            API_PUBLIC_URL=https://tu-backend.vercel.app
APP_URL=http://localhost:8766
API_PUBLIC_URL=

# Detras de un proxy (Railway, Render, Fly, Nginx): true solo si el proxy
# agrega X-Forwarded-For de forma confiable.
TRUST_PROXY=false

# Origenes permitidos para el navegador (separados por coma).
CORS_ORIGINS=https://francotomas44-del.github.io,http://localhost:8766,http://127.0.0.1:8766

# API keys en JSON.
# - "key": texto plano, solo para desarrollo local.
# - "keyHash": SHA-256 en hexadecimal, recomendado en produccion.
# - "scopes": analyze, live, meta, *.
# - "ips": allowlist de IPs/CIDR para esa key (opcional).
#
# Para desarrollo:
API_KEYS=[{"id":"dev","key":"dev_change_me","scopes":["*"],"ips":[]}]
#
# Para produccion (genera el hash con: npm run hash-key):
# API_KEYS=[{"id":"web","keyHash":"<sha256>","scopes":["analyze","live"],"ips":[]}]

# Allowlist global de IPs/CIDR. Vacio = sin allowlist.
# OJO: los navegadores usan la IP del usuario, que cambia. Esto sirve para
# llamadas server-to-server, no para restringir a los usuarios finales.
IP_ALLOWLIST=

# Limites
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute
# Vercel Functions limita el body a ~4,5 MB. Si desplegas ahi, no subas este valor.
BODY_LIMIT_BYTES=4500000
ANALYZE_MAX_MATCHES=50000
ANALYZE_MAX_TEAMS=20000

# Datos en vivo (upstream)
UPSTREAM_TIMEOUT_MS=8000
UPSTREAM_CACHE_MS=30000

# Estado de precios: proposed hasta que se aprueben. approved habilita el
# checkout, pero ademas hace falta configurar un proveedor y sus price/plan IDs.
PRICING_STATUS=proposed

# Precios propuestos (todavia no se cobra)
PLAN_PRO_ARS_MONTHLY=6900
PLAN_PRO_ARS_YEARLY=59000
PLAN_PRO_USD_MONTHLY=9
PLAN_PRO_USD_YEARLY=90
PLAN_ELITE_ARS_MONTHLY=14900
PLAN_ELITE_ARS_YEARLY=129000
PLAN_ELITE_USD_MONTHLY=19
PLAN_ELITE_USD_YEARLY=190

# IDs de precio de Paddle (creados en el dashboard de Paddle Billing).
PLAN_PADDLE_PRO_MONTHLY=
PLAN_PADDLE_PRO_YEARLY=
PLAN_PADDLE_ELITE_MONTHLY=
PLAN_PADDLE_ELITE_YEARLY=

# IDs de plan de suscripcion de Mercado Pago (preapproval_plan_id).
PLAN_MP_PRO_MONTHLY=
PLAN_MP_PRO_YEARLY=
PLAN_MP_ELITE_MONTHLY=
PLAN_MP_ELITE_YEARLY=

# Pagos: completar recien cuando se active el cobro.
# Paddle: sandbox usa sandbox-api.paddle.com; production usa api.paddle.com.
# El checkout solo se habilita si estan la API key, el webhook secret y al
# menos un price ID. PADDLE_API_BASE permite overridear la URL de la API.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_BASE=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Mercado Pago: el checkout solo se habilita con access token, webhook secret
# y al menos un preapproval_plan_id. MP_API_BASE permite overridear la API.
MP_API_BASE=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Base de datos PostgreSQL (Neon, Vercel Postgres, Supabase).
# Sin DATABASE_URL, en produccion las cuentas no funcionan.
# En desarrollo se usa un store en memoria.
DATABASE_URL=

# Autenticacion por magic link y sesiones.
SESSION_COOKIE_NAME=futbolityx_session
SESSION_DAYS=30
MAGIC_LINK_MINUTES=15
# Solo para desarrollo local: devuelve el magic link en la respuesta.
AUTH_DEV_MODE=false

# Email (Resend). Sin RESEND_API_KEY, en desarrollo el link se imprime en consola.
RESEND_API_KEY=
EMAIL_FROM=Futbolityx <no-reply@futbolityx.com>

# URL de retorno despues del pago (opcional; por defecto APP_URL).
BILLING_RETURN_URL=
